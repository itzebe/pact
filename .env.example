# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------
# "development" is what permits the no-credentials mock path documented in the
# README. Any other value (including the default, "production") treats the
# deployment as real: it refuses to start without PayPal credentials and refuses
# to serve a request without an auth secret. Set this to "production" explicitly
# on any deployment that is meant to move real money.
PACT_ENV=development

# ---------------------------------------------------------------------------
# Authentication — REQUIRED
# ---------------------------------------------------------------------------
# Every /api route that reads or moves money requires a signed bearer token.
# PACT_AUTH_SECRET is the HS256 signing key. If it is unset the API fails closed:
# every protected request is refused with 503 rather than served anonymously.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Mint a token with:  python -m scripts.issue_token <subject> <buyer|seller|admin>
PACT_AUTH_SECRET=
# Algorithm used to sign tokens. Leave as HS256 unless you have a reason.
PACT_AUTH_ALGORITHM=HS256
# Hosts the API may be reached on, used to reject a forged Host / X-Forwarded-Host
# before it can become a PayPal return_url. Comma separated, no scheme.
PACT_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ---------------------------------------------------------------------------
# PayPal — required for real sandbox settlement
# ---------------------------------------------------------------------------
# Create a free developer account, then copy the sandbox credentials from
# https://developer.paypal.com/dashboard/applications/sandbox
# Pact uses these to place real authorizations and captures in PayPal Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------------
# AI — any OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# Without a key, Pact falls back to a deterministic mock policy engine so the
# full lifecycle still runs end to end. Set these to use a real model.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=90

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# REQUIRED in production. The startup check refuses to run when PACT_ENV is not a
# development/test value and this is unset or empty, because without a shared
# database a production deployment silently falls back to process-local ticket
# storage (a ticket consumed by one instance is replayable against another) and to
# non-durable local files (lost on cold start, invisible to other instances).
#
# In development it may be left unset: jobs and the reputation ledger are then
# stored as JSON files under PACT_DATA_DIR, which is correct for a single container
# with a mounted volume. Set it anyway when there is no durable disk (serverless
# platforms such as Vercel, or any multi-instance deployment).
#
# It also carries the single-use registry for SSE stream tickets: with it set, a
# captured ticket cannot be replayed against another instance.
#
# On a managed platform this is usually the *pooled* endpoint. For Neon that is the
# host with a "-pooler" suffix, which is PgBouncer in transaction mode. The pooled
# endpoint is correct for ordinary request/response queries, which is why it stays
# the default. It is NOT correct for the settlement advisory lock: a transaction-mode
# pooler hands the server connection back after every transaction, so a session lock
# taken through it is released between statements. That work uses DATABASE_URL_UNPOOLED
# below.
# DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/pact

# Recommended for a pooled application DSN. The *direct* (unpooled) endpoint for the
# same database — for Neon, the host WITHOUT the "-pooler" suffix. The settlement
# advisory lock is a session lock held across an external PayPal capture, so it must
# run on a real session, not through the transaction-mode pooler.
#
# When it is unset and DATABASE_URL is a Neon-style "-pooler" host, the direct host is
# derived automatically (the pooled host with "-pooler" removed — the same edit Neon
# documents). Set this explicitly when the provider is not Neon, or when the pooler
# host does not carry a recognizable label. The endpoint actually used is verified
# with a live probe before any session lock is taken, so a wrong guess is refused
# rather than used.
#
# In development, and against a plain PostgreSQL with no pooler, leave this unset.
# DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/pact

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
PACT_CURRENCY=USD
PACT_SELLERS=seller_atlas,seller_nova,seller_quill
PACT_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Public base URL of this deployment. It becomes the PayPal order's return_url, so
# PayPal sends an approving buyer back here. Leave unset and the request's own host
# is used (correct behind a proxy such as Vercel); set it when the public host
# differs from the one the API is reached on.
# PACT_PUBLIC_URL=https://pact-flame.vercel.app
# Set to false to refuse to start without real PayPal credentials.
PACT_ALLOW_MOCK_PAYPAL=true
# Set to true on any deployment where a settlement must be real. The in-memory
# mock moves no money, so a job settled against it is not a payment. This makes
# missing credentials a hard failure instead of a silently fake "settled" job.
PACT_REQUIRE_REAL_PAYPAL=false

# ---------------------------------------------------------------------------
# Customer accounts (OPTIONAL, off by default)
# ---------------------------------------------------------------------------
# Self-service registration/login/refresh/password-reset. Disabled unless this is
# true, because it needs a transactional email provider and a verified sending
# domain to be useful. While disabled, /api/auth/register returns 404.
# PACT_SELF_SERVICE_AUTH=true
# Access-token lifetime (minutes) and refresh-family lifetime (days).
PACT_ACCESS_TOKEN_TTL_MINUTES=15
PACT_REFRESH_TOKEN_TTL_DAYS=30
# Optional server-side pepper mixed into password hashing (Argon2id). Not a
# substitute for the per-hash salt; a defence in depth against a DB-only breach.
# PACT_PASSWORD_PEPPER=
# Additional identities that public registration may never create, on top of the
# PACT_SELLERS personas.
# PACT_RESERVED_IDENTITIES=

# Transactional email. Until a provider and credentials are set, verification and
# reset messages are recorded as queued and never claimed as delivered.
# PACT_EMAIL_PROVIDER=resend
# PACT_EMAIL_API_KEY=
# PACT_EMAIL_FROM=Pact <no-reply@your-verified-domain.example>
# PACT_EMAIL_BASE_URL=https://api.resend.com
# PACT_EMAIL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# PostgreSQL connection pool (per instance)
# ---------------------------------------------------------------------------
# Bounded pool shared by every store. The fleet's worst case is
# active instances x PACT_PG_POOL_MAX_SIZE, so budget it against the DB plan.
# The statement timeout is applied with a post-connect SET, never as a libpq
# `options` startup parameter — a managed pooler (Neon, pgbouncer) rejects that
# and every connection fails. Set 0 to leave the server default.
PACT_PG_POOL_MAX_SIZE=5
PACT_PG_POOL_MIN_SIZE=0
PACT_PG_POOL_TIMEOUT_SECONDS=5.0
PACT_PG_POOL_MAX_IDLE_SECONDS=300
PACT_PG_STATEMENT_TIMEOUT_MS=10000
